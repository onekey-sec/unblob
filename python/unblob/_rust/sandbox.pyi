from _typeshed import Incomplete
from os import PathLike
from typing import Final, final

@final
class AccessFS:
    @staticmethod
    def make_dir(dir: str |PathLike[str]) -> AccessFS: ...
    @staticmethod
    def make_reg(dir: str |PathLike[str]) -> AccessFS: ...
    @staticmethod
    def read(dir: str |PathLike[str]) -> AccessFS: ...
    @staticmethod
    def read_write(dir: str |PathLike[str]) -> AccessFS: ...
    @staticmethod
    def remove_dir(dir: str |PathLike[str]) -> AccessFS: ...
    @staticmethod
    def remove_file(dir: str |PathLike[str]) -> AccessFS: ...

@final
class SandboxErrorKind:
    NotEnforced: Final[SandboxErrorKind]
    NotImplemented: Final[SandboxErrorKind]
    Unknown: Final[SandboxErrorKind]
    def __eq__(self, value: object, /) -> bool: ...
    def __int__(self, /) -> int: ...
    def __ne__(self, value: object, /) -> bool: ...
    def __repr__(self, /) -> str: ...

def restrict_access(*rules: "AccessFS") -> None:
    """
    Enforces access restrictions
    """

def __getattr__(name: str) -> Incomplete: ...
